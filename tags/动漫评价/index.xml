    <item>
      <title>《终将成为你》动漫长评</title>
      <link>https://blog.pantsu0721.top/post/2024/2024-11-02-%E7%BB%88%E5%B0%86%E6%88%90%E4%B8%BA%E4%BD%A0%E5%8A%A8%E6%BC%AB%E9%95%BF%E8%AF%84/</link>
